{
	"name": "sarta-backend",
	"version": "1.0.0",
	"description": "Backend para o Sistema de Alerta e Recepção de Telemetria Assíncrona (SARTA), usado para meu TCC",
	"main": "app.js",
	"repository": "https://github.com/lucasasmuniz/sarta",
	"author": "Lucas Muniz <lucasasmuniz3@gmail.com>",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "tsx src/app.ts",
		"build": "tsc && tsc-alias",
		"build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"commit": "cz",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"lint-staged": {
		"src/**/*.{ts,json}": "yarn lint:fix --no-errors-on-unmatched"
	},
	"dependencies": {
		"argon2": "^0.44.0",
		"bullmq": "^5.76.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.5",
		"fastify-type-provider-zod": "^6.1.0",
		"ioredis": "^5.10.1",
		"jose": "^6.2.2",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@commitlint/cli": "^20.5.2",
		"@commitlint/config-conventional": "^20.5.0",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"commitizen": "^4.3.1",
		"cz-conventional-changelog": "^3.3.0",
		"drizzle-kit": "^0.31.10",
		"lint-staged": "^16.4.0",
		"pino-pretty": "^13.1.3",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	}
}
